# Copy to keystore.properties (untracked) to sign release builds.
#
# Generate the keystore once and keep it somewhere safe — Android identifies an
# app by its signing key, so losing it means every install has to be uninstalled
# and replaced rather than updated:
#
#   keytool -genkeypair -v -keystore blacktop-release.jks \
#     -keyalg RSA -keysize 4096 -validity 10000 -alias blacktop
#
storeFile=blacktop-release.jks
storePassword=CHANGE_ME
keyAlias=blacktop
keyPassword=CHANGE_ME
